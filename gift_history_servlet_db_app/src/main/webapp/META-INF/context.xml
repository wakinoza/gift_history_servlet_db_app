<?xml version="1.0" encoding="UTF-8" ?>
<Context useHttpOnly="true">
  <Resource
    name="jdbc/gift_db"
    auth="Container"
    type="javax.sql.DataSource"
    driverClassName="com.mysql.cj.jdbc.Driver"
    url="jdbc:mysql://localhost:3306/gift_db?serverTimezone=Asia/Tokyo&amp;characterEncoding=UTF-8&amp;useServerPrepStmts=true"
    username="gift_user"
    password="gift_user"
    maxTotal="20"
    maxIdle="10"
    maxWaitMillis="-1"
   />
</Context>

